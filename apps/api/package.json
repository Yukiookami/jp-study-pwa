{
  "name": "@jp-study/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:deploy": "tsx src/migrate.ts deploy",
    "db:migrate": "tsx src/migrate.ts dev",
    "lessons:import": "tsx src/import-cli.ts"
  },
  "dependencies": {
    "@jp-study/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "fastify": "5.6.1",
    "@fastify/static": "8.3.0",
    "dotenv": "17.2.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
