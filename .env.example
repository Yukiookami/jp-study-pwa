# 本机配置示例；建议用 pnpm env:init 生成随机凭据。
# 根目录 .env 仅供本机配置，禁止提交真实凭据。
POSTGRES_DB=jp_study
POSTGRES_USER=jp_study
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://jp_study:replace-with-a-local-password@127.0.0.1:5433/jp_study
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=5174
# 从仓库根目录解析；长期运行可配置绝对路径。
LESSONS_ROOT=./lessons
APP_TIMEZONE=Asia/Tokyo
